{
  "name": "food-track",
  "version": "0.1.0",
  "description": "A collaborative food map for recording and reviewing dining experiences.",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch --tsconfig tsconfig.node.json server/main.ts",
    "dev:client": "cross-env NODE_ENV=development vite --config vite.config.ts",
    "gen:db-schema": "npx -y @lark-apaas/db-schema-sync@latest --output server/database/schema.ts --export-custom-types",
    "gen:openapi": "echo 'UNSUPPORTED, SKIP'",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "build:prod": "npm run build",
    "build:server": "cross-env NODE_ENV=production tsc --project tsconfig.node.json && node scripts/copy-server-assets.mjs",
    "build:client": "cross-env NODE_ENV=production vite build --config vite.config.ts",
    "start": "cross-env NODE_ENV=production node dist/server/main.js",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/e2e/jest.config.js",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "eslint": "eslint . --quiet",
    "stylelint": "stylelint client/src/**/*.css --quiet",
    "type:check": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run type:check:server\" \"npm run type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "lint": "npm run eslint && npm run stylelint && npm run type:check",
    "format": "prettier --write \"{server,client,test}/**/*.{js,ts,tsx,json,md}\"",
    "precommit": "npm run lint",
    "prepare": "node scripts/configure-git-hooks.mjs",
    "postinstall": "fullstack-cli action-plugin init"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@lark-apaas/client-toolkit": "^1.2.72",
    "@lark-apaas/fullstack-nestjs-core": "^1.1.63",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.90.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "~2.0.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.44.6",
    "exceljs": "^4.4.0",
    "hbs": "^4.2.0",
    "lucide-react": "^0.554.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "~3.4.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.76",
    "zustand": "~5.0.8"
  },
  "devDependencies": {
    "@lark-apaas/fullstack-presets": "^1.1.0",
    "@lark-apaas/fullstack-vite-preset": "^1.0.33",
    "@nestjs/testing": "^10.4.20",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.3",
    "@types/hbs": "^4.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "react-refresh": "^0.17.0",
    "stylelint": "^16.11.0",
    "tailwindcss": "^4.1.13",
    "ts-jest": "^29.4.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.3.1"
  },
  "overrides": {
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-prometheus": "0.222.0",
    "@opentelemetry/propagator-jaeger": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "4.3.2",
      "lodash": "4.18.1"
    },
    "dayjs": "^1.11.15",
    "lodash": "4.18.1",
    "tmp": "0.2.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/client/src/$1",
      "^@client/(.*)$": "<rootDir>/client/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@server/(.*)$": "<rootDir>/server/$1"
    },
    "testMatch": [
      "<rootDir>/server/**/*.spec.ts",
      "<rootDir>/test/unit/**/*.spec.ts"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.0.1",
  "actionPlugins": {
    "@official-plugins/feishu-bitable": "1.0.22"
  },
  "patchedDependencies": {
    "drizzle-orm@0.44.6": "patches/drizzle-orm@0.44.6.patch"
  }
}
